{
  "type": "minecraft:multi_action",
  "title": {
    "text": "🏁 Épreuve",
    "color": "gold"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text": "Prépare la commande d'une épreuve, à coller dans un command block (derrière un bouton ou une plaque).",
        "color": "gray"
      }
    }
  ],
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "id",
      "label": {
        "text": "Nom de l'épreuve"
      },
      "initial": "epreuve1",
      "max_length": 32,
      "width": 200
    },
    {
      "type": "minecraft:text",
      "key": "time",
      "label": {
        "text": "Durée (secondes)"
      },
      "initial": "30",
      "max_length": 5,
      "width": 200
    },
    {
      "type": "minecraft:text",
      "key": "group",
      "label": {
        "text": "Groupe"
      },
      "initial": "main",
      "max_length": 32,
      "width": 200
    },
    {
      "type": "minecraft:boolean",
      "key": "sync",
      "label": {
        "text": "Démarrer au prochain cycle du groupe"
      },
      "initial": false,
      "on_true": "1",
      "on_false": "0"
    },
    {
      "type": "minecraft:boolean",
      "key": "tp_back",
      "label": {
        "text": "Revenir au point de départ à la fin"
      },
      "initial": true,
      "on_true": "1",
      "on_false": "0"
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "📋 Copier la commande",
        "color": "yellow"
      },
      "width": 200,
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "function #survirec:v1/challenge_cmd {with:{id:\"$(id)\",time:$(time),group:\"$(group)\",sync:$(sync),tp_back:$(tp_back)}}"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "Retour"
    },
    "width": 200,
    "action": {
      "type": "minecraft:show_dialog",
      "dialog": "survirec:menu"
    }
  }
}

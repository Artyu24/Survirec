    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": "Enregistre les mouvements d'un joueur et les rejoue avec des mannequins."
    },
    {
      "type": "minecraft:plain_message",
      "width": 300,
      "contents": {
        "text": "Par Artyu24",
        "color": "gray"
      }
    }

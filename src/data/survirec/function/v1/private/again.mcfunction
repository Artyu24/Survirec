# Relance une séquence déjà chargée dans CE monde (sans les données)
$data modify storage survirec:in a set value {name:"$(name)",entity:"$(entity)",range:$(range),grp:$(grp),gl:$(gl),group:"$(group)",gr:$(group_radius),size:$(size),loop:$(loop),rsb:$(redstone),cbx:$(cbx),cby:$(cby),cbz:$(cbz),restore:$(restore),hitp:$(hit_players),speed:$(speed),offset:$(delay),tag:"$(tag)",pose:"$(pose)",skin:"$(skin)",texture:"$(texture)",head:"$(head)",chest:"$(chest)",legs:"$(legs)",feet:"$(feet)",mainhand:"$(mainhand)",offhand:"$(offhand)"}
$execute positioned $(pos) run function survirec:v1/private/p/spawn
